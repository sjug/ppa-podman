#!/usr/bin/make -f

export DH_VERBOSE = 1
export HOME = $(CURDIR)/debian/_build_home
export GOPATH = $(CURDIR)/_build
export GOFLAGS = -mod=vendor -buildmode=pie
export PATH := /usr/lib/go-1.25/bin:$(PATH)

PREFIX = /usr
EXTRA_LDFLAGS = -linkmode=external

# BUILDTAGS is intentionally NOT overridden: podman's Makefile auto-detects
# apparmor/seccomp/systemd/btrfs/grpcnotrace from the installed -dev libraries
# (matching upstream Arch's bare `make`). libsqlite3-dev is deliberately omitted
# from Build-Depends so the pure-Go SQLite driver is used, not cgo libsqlite3.

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(HOME)

override_dh_auto_build:
	$(MAKE) EXTRA_LDFLAGS="$(EXTRA_LDFLAGS)" PREFIX=$(PREFIX) podman podman-remote rootlessport quadlet docs
	# Podman 6 dropped cgroups v1 support; do not run build steps that execute podman.

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/podman PREFIX=$(PREFIX)
	$(MAKE) install.completions DESTDIR=$(CURDIR)/debian/podman PREFIX=$(PREFIX)

override_dh_auto_test:
	# Full tests require container runtime and namespace support.
	set -eu; \
	container_libs_version="$$(cat /usr/share/containers/container-libs.version)"; \
	container_libs_version="$${container_libs_version#v}"; \
	project_container_libs_version="$$(sed -n -E 's|.*go[.]podman[.]io/common v([0-9]+[.][0-9]+[.][0-9]+).*|\1|p' go.mod)"; \
	printf 'Podman requires container-libs/common %s; installed containers-common provides %s\n' "$$project_container_libs_version" "$$container_libs_version"; \
	test "$$container_libs_version" = "$$project_container_libs_version"

override_dh_dwz:
	# dwz does not work with Go binaries

override_dh_strip:
	# Do not strip Go binaries
